// 09 - A tiny CLI tool
//
// Shows args(), env() and exit().
//
// Run:   nac examples/basics/09_cli_tool.nac greet Alice
//        nac examples/basics/09_cli_tool.nac add 4 5
//        nac examples/basics/09_cli_tool.nac

cliArgs = args()

if (length(cliArgs) == 0) {
    print("Usage:")
    print("  nac 09_cli_tool.nac greet <name>")
    print("  nac 09_cli_tool.nac add <a> <b>")
    exit(1)
}

command = cliArgs[0]

if (command == "greet") {
    name = "World"
    if (length(cliArgs) > 1) {
        name = cliArgs[1]
    }
    user = env("USER")
    print("Hello, " + name + "! (run by: " + user + ")")
    exit(0)
}

if (command == "add") {
    if (length(cliArgs) < 3) {
        print("Error: the add command expects two numbers.")
        exit(1)
    }
    a = toInt(cliArgs[1])
    b = toInt(cliArgs[2])
    print(a + " + " + b + " = " + (a + b))
    exit(0)
}

print("Unknown command: " + command)
exit(1)
