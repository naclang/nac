// 02 - Conditions and loops
//
// Run:  nac examples/basics/02_control_flow.nac

// if / elif / else, with and / or / not
x = 5
if x > 3 and not (x == 4) {
    print("x is big")
} elif x == 3 {
    print("x is three")
} else {
    print("x is small")
}

// while
count = 0
while count < 3 {
    count++
}
print("count:", count)

// for over a range (the end is exclusive) and over an array
for i in range(3) {
    print("i =", i)
}
total = 0
for n in [10, 20, 30] {
    total += n
}
print("total:", total)

// break
for k in range(100) {
    if k * k > 50 {
        print("first k with k*k > 50:", k)
        break
    }
}

// Nested loops: a multiplication table
for row in range(1, 4) {
    line = ""
    for col in range(1, 4) {
        line += row * col + " "
    }
    print(line)
}

// and / or short-circuit, so the second operand is not evaluated here
items = [1, 2]
if len(items) > 5 and items[10] == 1 {
    print("never printed")
}
