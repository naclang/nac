// 06 - Error handling: try / catch / throw
//
// Run:  nac examples/basics/06_errors.nac

// 1) Runtime errors can be caught
try {
    data = jsonParse("{broken json")
    print("not reached")
} catch e {
    print("caught:", e)
}

// 2) Raise your own errors with throw
fn divide(a, b) {
    if b == 0 {
        throw "cannot divide by zero"
    }
    return a / b
}

try {
    print(divide(10, 2))
    print(divide(1, 0))
} catch err {
    print("error:", err)
}

// 3) Fall back to a default when something fails
fn safe_json(text) {
    try {
        return jsonParse(text)
    } catch {
        return null
    }
}
print(safe_json("{\"a\": 1}").a, safe_json("{{"))

// 4) Out-of-range access is an error too
items = [1, 2, 3]
try {
    removeAt(items, 9)
} catch e {
    print("caught:", e)
}

// 5) Network errors are not thrown: check res.ok and res.error
res = http.get { url: "http://127.0.0.1:1/", timeout: 2 }
if not res.ok {
    print("request failed:", res.error)
}
