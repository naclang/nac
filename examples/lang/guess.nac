// Example: Number Guessing Game
// ---------------------------------------------------

secret = 1 + (now() % 100)
guess = null

for attempt in range(10) {
    guess = int(input("Tahmininizi girin (1-100): "))

    if guess == secret {
        print("Tebrikler! Sayiyi bildiniz.")
        break
    } elif guess < secret {
        print("Daha buyuk bir sayi deneyin.")
    } else {
        print("Daha kucuk bir sayi deneyin.")
    }
}

if guess != secret {
    print("Uzgunum, hakkiniz bitti. Sayim:", secret)
}
