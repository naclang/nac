// examples/try.nac -- hata yakalama: try / catch / throw

// 1) Calisma zamani hatalari yakalanir
try {
    data = jsonParse("{bozuk json")
    print("buraya gelmez")
} catch e {
    print("yakalandi:", e)
}

// 2) throw ile kendi hatani firlat
fn bol(a, b) {
    if b == 0 { throw "sifira bolunemez" }
    return a / b
}

try {
    print(bol(10, 2))
    print(bol(1, 0))
} catch err {
    print("hata:", err)
}

// 3) Fonksiyon icinde: hata olursa varsayilan deger don
fn guvenliJson(text) {
    try { return jsonParse(text) } catch { return null }
}
print(guvenliJson("{\"a\": 1}").a, guvenliJson("{{"))

// 4) HTTP: ag hatasi firlatilmaz, res.ok / res.error ile bakilir
res = http.get { url: "http://127.0.0.1:1/", timeout: 2 }
if not res.ok { print("istek basarisiz:", res.error) }
