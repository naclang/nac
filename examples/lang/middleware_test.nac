// examples/lang/middleware_test.nac -- before / after blocks
//
// Run:  nac test examples/lang/middleware_test.nac

hits = 0
currentUser = null
log = []

// Runs for every request (also 404s and OPTIONS).
before {
    hits = hits + 1
    if method == "OPTIONS" {
        return { status: 204, body: "" }      // answers the CORS preflight
    }
}

// Only for /admin and below. `return` ends the request; falling off the end
// continues to the route.
before "/admin/*" {
    token = headers.authorization or ""
    if token != "Bearer secret" {
        return json({ error: "unauthorized" }, 401)
    }
    currentUser = "admin"                     // visible in the route
}

// Runs after every response. `response` is { status, body, headers }.
after {
    setHeader(cors("*", "GET, POST, OPTIONS", "Content-Type, Authorization"))
    setHeader("X-Served-By", "nac")
    push(log, `${method} ${path} -> ${response.status}`)
}

// Only for the API: a block that returns a response replaces it.
after "/api/*" {
    if response.status == 404 {
        return json({ error: "no such api route" }, 404)
    }
}

route GET "/" {
    return "home"
}

route GET "/admin/panel" {
    return `hello ${currentUser}`
}

route GET "/api/ping" {
    setHeader("X-Served-By", "route")         // an after block may override it
    return { status: 200, body: "pong", headers: { "X-Route": "yes" } }
}

// 1. before + route + after on a plain route
r = request("GET", "/")
assert(r.status == 200, "route still runs")
assert(r.body == "home", "route body")
assert(r.headers["X-Served-By"] == "nac", "after block set a header with setHeader")
assert(r.headers["Access-Control-Allow-Origin"] == "*", "setHeader(cors(...)) sets all CORS headers")

// 2. a before block answers the preflight; after blocks still decorate it
p = request("OPTIONS", "/anything")
assert(p.status == 204, "before block answered OPTIONS")
assert(p.headers["Access-Control-Allow-Methods"] == "GET, POST, OPTIONS", "CORS headers on the preflight")

// 3. a pattern limits a block, and a returning before skips the route
denied = request("GET", "/admin/panel")
assert(denied.status == 401, "admin route needs a token")
assert(jsonParse(denied.body).error == "unauthorized", "401 body from before")
assert(denied.headers["X-Served-By"] == "nac", "after still runs after a before answered")

ok = request("GET", "/admin/panel", "", { Authorization: "Bearer secret" })
assert(ok.status == 200, "token accepted")
assert(ok.body == "hello admin", "a global set in before is visible in the route")

// 4. blocks without a matching pattern are skipped
home = request("GET", "/")
assert(home.status == 200, "/ is not behind the admin check")

// 5. after sees the route's response and can replace it
ping = request("GET", "/api/ping")
assert(ping.body == "pong", "after left the response alone")
assert(ping.headers["X-Route"] == "yes", "route headers are kept")
assert(ping.headers["X-Served-By"] == "nac", "setHeader replaced the route's header of the same name")
missing = request("GET", "/api/nope")
assert(missing.status == 404, "still a 404")
assert(jsonParse(missing.body).error == "no such api route", "after replaced the 404 body")
other404 = request("GET", "/nope")
assert(contains(other404.body, "Not Found"), "other 404s are untouched")

// 6. before runs for every request, after saw every status
assert(hits == 8, "before ran once per request")
assert(log[0] == "GET / -> 200", "after can log method, path and status")
assert(log[1] == "OPTIONS /anything -> 204", "after logs preflight")

print("middleware OK")
