// Test: compound assignment operators (+= -= *= /=)

// Plain variables
x = 10
x += 5
print(x);   // 15
x -= 3
print(x);   // 12
x *= 2
print(x);   // 24
x /= 4
print(x);   // 6

// String concatenation via +=
s = "Hello"
s += ", world!"
print(s);   // Hello, world!

// float coercion
f = 1.5
f += 1
print(f);   // 2.5

// array element compound assign
a = [1, 2, 3]
a[0] += 100
a[1] *= 10
print(a[0]);  // 101
print(a[1]);  // 20

// map element compound assign
m = map()
m["count"] = 1
m["count"] += 1
m["count"] += 1
print(m["count"]);  // 3

// compound assign in a for-loop increment
total = 0
for i in range(0, 5) {
    total += i
}
print(total);  // 0+1+2+3+4 = 10
