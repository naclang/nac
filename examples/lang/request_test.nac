route GET "/hello/:name" {
    return json({ message: "Hello, " + params.name })
}

route GET "/" {
    return render("examples/web/templates/greeting.html", { title: "NaC", name: "NaC" })
}

route GET "/search" {
    return json({ term: query.term })
}

route POST "/echo" {
    return json({ body: body, contentType: headers["content-type"] })
}

response = request("GET", "/hello/Ada")
assert(response.status == 200, "route should return 200")
data = jsonParse(response.body)
assert(data.message == "Hello, Ada", "path parameter should reach route")

queryResponse = request("GET", "/search?term=hello+world")
queryData = jsonParse(queryResponse.body)
assert(queryData.term == "hello world", "query parameters should be decoded")

postResponse = request("POST", "/echo", "payload", { "content-type": "text/plain" })
postData = jsonParse(postResponse.body)
assert(postData.body == "payload", "request body should reach route")
assert(postData.contentType == "text/plain", "request header names should be normalized")

root = request("GET", "/")
assert(root.status == 200, "root route should return 200")
assert(contains(root.body, "Hello, NaC!"), "root route should render the default greeting")

page = render("examples/web/templates/greeting.html", { title: "<Ada>", name: "<Ada>" })
assert(contains(page.body, "&lt;Ada&gt;"), "template values must be HTML-escaped")
