// Example: Prime Number Check
// ---------------------------------------------------

fn is_prime(num) {
    if(num < 2) {
        return 0
    }
    
    i = 2
    while i * i <= num {
        if num % i == 0 {
            return 0
        }
        i++
    }
    
    return 1
}

print("Prime numbers between 2 and 30:")
for number in range(2, 30 + 1) {
    if is_prime(number) {
        print(number)
    }
}
