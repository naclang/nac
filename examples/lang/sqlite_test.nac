// examples/lang/sqlite_test.nac -- SQLite: dbOpen, dbExec, dbQuery, dbGet, dbClose
//
// Run:  nac test examples/lang/sqlite_test.nac
// Needs a NaC build with SQLite (see README); without it the test is skipped.

db = null
try {
    db = dbOpen(":memory:")
} catch e {
    print("sqlite test skipped: " + e)
    exit(0)
}

// --- creating tables and inserting ---------------------------------------
created = dbExec(db, "CREATE TABLE users(id INTEGER PRIMARY KEY, name TEXT NOT NULL, age INTEGER, score REAL, active INTEGER)")
assert(created.changes == 0, "CREATE TABLE changes no rows")

ada = dbExec(db, "INSERT INTO users(name, age, score, active) VALUES (?, ?, ?, ?)", ["Ada", 36, 9.5, true])
assert(ada.changes == 1, "an INSERT changes one row")
assert(ada.lastId == 1, "lastId is the new row id")

// named placeholders take a map
bob = dbExec(db, "INSERT INTO users(name, age) VALUES (:name, :age)", { name: "Bob", age: 41 })
assert(bob.lastId == 2, "named parameters work")

dbExec(db, "INSERT INTO users(name) VALUES (?)", ["Cy"])

// --- reading -------------------------------------------------------------
rows = dbQuery(db, "SELECT * FROM users ORDER BY id")
assert(len(rows) == 3, "three rows")
assert(rows[0].name == "Ada", "text column")
assert(rows[0].age == 36, "integer column")
assert(typeOf(rows[0].age) == "int", "integers stay ints")
assert(rows[0].score == 9.5, "real column")
assert(rows[0].active == 1, "booleans are stored as 0/1")
assert(isNull(rows[1].score), "NULL becomes null")
assert(isNull(rows[2].age), "NULL becomes null (int column)")

one = dbGet(db, "SELECT name, age FROM users WHERE id = ?", [2])
assert(one.name == "Bob" and one.age == 41, "dbGet returns the first row as a map")
assert(isNull(dbGet(db, "SELECT * FROM users WHERE id = ?", [99])), "dbGet gives null when nothing matches")
assert(len(dbQuery(db, "SELECT * FROM users WHERE age > ?", [100])) == 0, "no rows is an empty array")

counted = dbGet(db, "SELECT COUNT(*) AS n FROM users")
assert(counted.n == 3, "aggregates")

// integers beyond 32 bits come back as floats
big = dbGet(db, "SELECT 5000000000 AS big")
assert(typeOf(big.big) == "float" and big.big > 2147483647, "a big integer keeps its value (as a float)")

// rows are plain maps, so they go straight into json()
assert(contains(jsonStringify(dbQuery(db, "SELECT name FROM users WHERE id = 1")), "Ada"), "rows serialize to JSON")

// --- update / delete -----------------------------------------------------
upd = dbExec(db, "UPDATE users SET age = age + 1 WHERE age IS NOT NULL")
assert(upd.changes == 2, "UPDATE reports the rows it changed")
del = dbExec(db, "DELETE FROM users WHERE name = ?", ["Cy"])
assert(del.changes == 1, "DELETE reports the rows it removed")

// --- values are bound, never pasted into the SQL -------------------------
evil = "x'); DROP TABLE users; --"
dbExec(db, "INSERT INTO users(name) VALUES (?)", [evil])
stored = dbGet(db, "SELECT name FROM users WHERE name = ?", [evil])
assert(stored.name == evil, "hostile text is stored as plain text")
assert(dbGet(db, "SELECT COUNT(*) AS n FROM users").n == 3, "the table is still there")

// --- several statements at once (no parameters) --------------------------
dbExec(db, "CREATE TABLE a(x); CREATE TABLE b(y); INSERT INTO a VALUES (1);")
assert(dbGet(db, "SELECT x FROM a").x == 1, "a script of statements runs in order")

// --- errors can be caught ------------------------------------------------
msg = ""
try { dbExec(db, "INSERT INTO users(name) VALUES (NULL)") } catch e { msg = e }
assert(contains(msg, "NOT NULL"), "constraint failures are catchable")

msg = ""
try { dbQuery(db, "SELEKT 1") } catch e { msg = e }
assert(contains(msg, "syntax error"), "syntax errors are catchable")

msg = ""
try { dbQuery(db, "SELECT ?", []) } catch e { msg = e }
assert(contains(msg, "placeholder"), "too few parameters is an error")

msg = ""
try { dbQuery(db, "SELECT :a", { b: 1 }) } catch e { msg = e }
assert(contains(msg, ":a"), "a missing named parameter is an error")

msg = ""
try { dbQuery(db, "SELECT 1; SELECT 2") } catch e { msg = e }
assert(contains(msg, "one SQL statement"), "dbQuery runs exactly one statement")

msg = ""
try { dbExec(db, "INSERT INTO a VALUES (?); INSERT INTO a VALUES (?)", [1, 2]) } catch e { msg = e }
assert(contains(msg, "single SQL statement"), "parameters need a single statement")
assert(dbGet(db, "SELECT COUNT(*) AS n FROM a").n == 1, "a refused script ran nothing")

msg = ""
try { dbExec(db, "INSERT INTO a VALUES (?)", [[1, 2]]) } catch e { msg = e }
assert(contains(msg, "can be bound"), "arrays cannot be bound")

// --- limits are reported, not silently truncated -------------------------
msg = ""
try { dbQuery(db, "WITH RECURSIVE c(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM c WHERE n < 10001) SELECT n FROM c") } catch e { msg = e }
assert(contains(msg, "more than 10000 rows"), "huge results are refused")

msg = ""
try { dbGet(db, "SELECT printf('%9000s', 'a') AS s") } catch e { msg = e }
assert(contains(msg, "limited to"), "text longer than a NaC string is refused")

msg = ""
try { dbGet(db, "SELECT x'41' AS b") } catch e { msg = e }
assert(contains(msg, "BLOB"), "BLOBs are refused with a hint")

// --- transactions are plain SQL ------------------------------------------
dbExec(db, "BEGIN")
dbExec(db, "INSERT INTO a VALUES (2)")
dbExec(db, "ROLLBACK")
assert(dbGet(db, "SELECT COUNT(*) AS n FROM a").n == 1, "ROLLBACK undoes the insert")
dbExec(db, "BEGIN")
dbExec(db, "INSERT INTO a VALUES (3)")
dbExec(db, "COMMIT")
assert(dbGet(db, "SELECT COUNT(*) AS n FROM a").n == 2, "COMMIT keeps it")

// --- foreign keys are enforced -------------------------------------------
dbExec(db, "CREATE TABLE posts(id INTEGER PRIMARY KEY, user_id INTEGER REFERENCES users(id))")
msg = ""
try { dbExec(db, "INSERT INTO posts(user_id) VALUES (12345)") } catch e { msg = e }
assert(contains(msg, "FOREIGN KEY"), "foreign keys are switched on")

// --- handles --------------------------------------------------------------
second = dbOpen(":memory:")
assert(second != db, "each dbOpen gives its own handle")
dbExec(second, "CREATE TABLE only_here(x)")
msg = ""
try { dbQuery(db, "SELECT * FROM only_here") } catch e { msg = e }
assert(contains(msg, "no such table"), "databases are separate")
dbClose(second)
msg = ""
try { dbQuery(second, "SELECT 1") } catch e { msg = e }
assert(contains(msg, "open database handle"), "a closed handle is refused")
msg = ""
try { dbQuery(42, "SELECT 1") } catch e { msg = e }
assert(contains(msg, "open database handle"), "a made-up handle is refused")
dbClose(db)

print("sqlite OK")
