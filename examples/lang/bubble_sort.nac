// Example: Sorting (Bubble Sort)
// ---------------------------------------------------

fn bubble_sort(arr, size) {
    for i in range(size - 1) {
        for j in range(size - i - 1) {
            if(arr[j] > arr[j + 1]) {
                // Swap
                temp = arr[j]
                arr[j] = arr[j + 1]
                arr[j + 1] = temp
            }
        }
    }
    return arr
}

unsorted = [64, 34, 25, 12, 22, 11, 90]
print("Unsorted:")
for i in range(7) {
    print(unsorted[i])
}

print("")

sorted = bubble_sort(unsorted, 7)
print("Sorted:")
for i in range(7) {
    print(sorted[i])
}
