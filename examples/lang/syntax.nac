/* Yeni sozdizimi turu: JavaScript'in suslu parantezleri + Python'un sadeligi. */

fn topla(a, b) {
    return a + b
}

x = 5
print(`x-1 = ${x-1}`)
print("topla:", topla(2, 3))

if x > 3 and not (x == 4) {
    print("x buyuk")
} elif x == 3 {
    print("uc")
} else {
    print("kucuk")
}

kisi = { isim: "Ada", "yas": 36, etiketler: ["a", "b"], adres: { sehir: "Istanbul" } }
print(`${kisi.isim} / ${kisi["yas"]} / ${kisi.adres.sehir} / ${kisi.etiketler[1]}`)

kisi.yas += 1
kisi.adres.sehir = "Ankara"
kisi.etiketler[0] = "z"
print(kisi.yas, kisi.adres.sehir, kisi.etiketler[0])

matris = [[1, 2], [3, 4]]
matris[1][0] = 30
print(matris[0][1] + matris[1][0])

toplam = 0
for n in [10, 20, 30] {
    toplam += n
}
print("toplam:", toplam)

for i in range(3) { print("i =", i) }
for k in keys(kisi) { print("anahtar:", k) }

print(2 in [1, 2, 3], "b" not in ["a", "b"], "yas" in kisi, "ad" in "Ada")

a = [5]
print(len(a), str(42) + "!", int("7") + 1)

i = 0
while i < 3 { i++ }
print("i:", i)

arr = [1, 2]
if len(arr) > 5 and arr[10] == 1 { print("asla") }   // kisa devre: hata yok

/* Sablon string: `...${ifade}...` (backtick); ifade her sey olabilir */
print(`toplam ${toplam}, ortalama ${toplam / 3}, ${toplam > 50 and "buyuk" or "kucuk"}`)

fn bos() { return }
print(bos() == null)
