// examples/web/01_hello.nac -- the smallest server
//
// Run:  ./nac examples/web/01_hello.nac
// Try:      curl http://localhost:8080/
//            curl "http://localhost:8080/hello?name=Alice"
//            curl http://localhost:8080/users/2

users = ["Ada", "Turing", "Grace"]

route GET "/" {
    return "Welcome to the NaC web server!"
}

// ?name=... query parameter (query is a map)
route GET "/hello" {
    name = query.name or "World"
    return `Hello, ${name}!`
}

// :id path parameter (params is a map)
route GET "/users/:id" {
    id = toInt(params.id)
    if id < 0 or id >= len(users) {
        return json({ error: "user not found" }, 404)
    }
    return json({ id: id, name: users[id] })
}

serve(8080)
