// examples/web/03_guestbook.nac -- an HTML form + data kept in a file
//
// Run:  ./nac examples/web/03_guestbook.nac
// Try:      http://localhost:8080/   (fill in the form in a browser)

FILE = "guestbook.txt"

// Escape user input before putting it in HTML
fn esc(s) {
    s = replace(s, "&", "&amp;")
    s = replace(s, "<", "&lt;")
    return replace(s, ">", "&gt;")
}

// "name=Ada&msg=Hello+world" -> { name: "Ada", msg: "Hello world" }
fn parseForm(text) {
    out = {}
    for pair in split(text, "&") {
        kv = split(pair, "=")
        if len(kv) == 2 { out[urlDecode(kv[0])] = urlDecode(kv[1]) }
    }
    return out
}

route GET "/" {
    items = ""
    try {
        for line in split(read(FILE), "\n") {
            if line != "" { items += `<li>${esc(line)}</li>` }
        }
    } catch e {
        items = "<li><i>No signatures yet.</i></li>"
    }
    return html(`<h1>Guestbook</h1>
<ul>${items}</ul>
<form method="POST" action="/sign">
  <input name="name" placeholder="Your name" required>
  <input name="msg" placeholder="Your message" required>
  <button>Sign</button>
</form>`)
}

route POST "/sign" {
    form = parseForm(body)
    if not ("name" in form) or not ("msg" in form) {
        return html("<p>Name and message are required.</p>", 400)
    }
    append(FILE, form.name + ": " + form.msg + "\n")
    return redirect("/")
}

serve(8080)
