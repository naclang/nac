// examples/web/02_json_api.nac -- bellekte calisan REST API (todo listesi)
//
// Calistir:  ./nac examples/web/02_json_api.nac
// Dene:
//   curl http://localhost:8080/todos
//   curl -X POST -d '{"title":"sut al"}' http://localhost:8080/todos
//   curl "http://localhost:8080/todos?done=true"
//   curl -X PATCH http://localhost:8080/todos/1/done
//   curl -X DELETE http://localhost:8080/todos/1
//   curl -X POST -d 'bozuk' http://localhost:8080/todos      (400 doner)

todos = []
nextId = 1

fn findIndex(id) {
    i = 0
    while i < len(todos) {
        if todos[i].id == id { return i }
        i++
    }
    return -1
}

route GET "/todos" {
    if "done" in query {
        wanted = query.done == "true"
        result = []
        for t in todos {
            if t.done == wanted { push(result, t) }
        }
        return json(result)
    }
    return json(todos)
}

route GET "/todos/:id" {
    i = findIndex(toInt(params.id))
    if i < 0 { return json({ error: "bulunamadi" }, 404) }
    return json(todos[i])
}

route POST "/todos" {
    try {
        data = jsonParse(body)
    } catch e {
        return json({ error: "gecersiz JSON" }, 400)
    }
    if type(data) != "map" or not ("title" in data) {
        return json({ error: "title gerekli" }, 400)
    }
    todo = { id: nextId, title: data.title, done: false }
    nextId += 1
    push(todos, todo)
    return json(todo, 201)
}

route PATCH "/todos/:id/done" {
    i = findIndex(toInt(params.id))
    if i < 0 { return json({ error: "bulunamadi" }, 404) }
    todos[i].done = true
    return json(todos[i])
}

route DELETE "/todos/:id" {
    id = toInt(params.id)
    if findIndex(id) < 0 { return json({ error: "bulunamadi" }, 404) }
    kept = []
    for t in todos {
        if t.id != id { push(kept, t) }
    }
    todos = kept
    return json({ deleted: id })
}

serve(8081)
