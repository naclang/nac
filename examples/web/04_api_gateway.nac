// examples/web/04_api_gateway.nac -- a route that calls another API (needs internet)
//
// Run:  ./nac examples/web/04_api_gateway.nac
// Try:      curl http://localhost:8080/ip
//
// If the upstream service fails the server keeps running and returns 502.

fn logUpstream(r) {
    print("upstream:", r.status, r.error or "")
}

route GET "/ip" {
    res = http.get {
        url: "https://api.ipify.org/?format=json",
        timeout: 5,
        callback: logUpstream
    }
    if not res.ok {
        return json({ error: "upstream basarisiz", detail: res.error }, 502)
    }
    return json({ sunucunun_ip_adresi: res.data.ip })
}

serve(8080)
