// examples/web/11_middleware.nac -- before / after blocks (middleware)
//
// Run:  ./nac examples/web/11_middleware.nac
// Try:      curl -i http://localhost:8080/
//            curl -i http://localhost:8080/admin/stats
//            curl -i -H "Authorization: Bearer secret" http://localhost:8080/admin/stats
//            curl -i -X OPTIONS http://localhost:8080/anything     (CORS preflight)

requestCount = 0
currentUser = null

// Runs before every request (including 404s and OPTIONS). If it `return`s a
// value the request ends there; otherwise the next block or the route runs.
before {
    requestCount = requestCount + 1
    if method == "OPTIONS" {
        return { status: 204, body: "" }
    }
}

// Only /admin and its subpaths: a simple authorization check.
before "/admin/*" {
    if (headers.authorization or "") != "Bearer secret" {
        return json({ error: "unauthorized" }, 401)
    }
    currentUser = "admin"          // also visible in the route
}

// For every response: CORS headers + logging. `response` = { status, body, headers }.
after {
    setHeader(cors("*", "GET, POST, OPTIONS", "Content-Type, Authorization"))
    print(`${method} ${path} -> ${response.status}`)
}

route GET "/" {
    return `Hello! This is request ${requestCount}.`
}

route GET "/admin/stats" {
    return json({ user: currentUser, requests: requestCount })
}

serve(8080)
