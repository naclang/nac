// examples/web/site/site.nac
// Statik dosyalar + route'lar ile tam bir site.
//
// Calistir:  nac examples/web/site/site.nac   (proje kokunden)
// Dene:      http://localhost:8080/

users = ["Ada", "Turing", "Grace"]

static("examples/web/site/public")            // "/" -> public/index.html

route GET "/hello/:name" {
    return html(`<h1>Merhaba, ${params.name}!</h1>`)
}

route GET "/api/users" {
    return json(users)
}

route GET "/api/users/:id" {
    id = toInt(params.id)
    if id < 0 or id >= length(users) {
        return json({ error: "kullanici yok" }, 404)
    }
    return json({ id: id, name: users[id] })
}

route POST "/api/users" {
    data = jsonParse(body)
    push(users, data.name)
    return json(users, 201)
}

route GET "/old" {
    return redirect("/")
}

serve(8080)
